{
  "number": 55,
  "name": "سُورَةُ الرَّحۡمَٰن",
  "englishName": "Ar-Rahmaan",
  "revelationType": "Medinan",
  "ayahs": [
    {
      "number": 4902,
      "numberInSurah": 1,
      "juz": 27,
      "text": "بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ ٱلرَّحْمَٰنُ"
    },
    {
      "number": 4903,
      "numberInSurah": 2,
      "juz": 27,
      "text": "عَلَّمَ ٱلْقُرْءَانَ"
    },
    {
      "number": 4904,
      "numberInSurah": 3,
      "juz": 27,
      "text": "خَلَقَ ٱلْإِنسَٰنَ"
    },
    {
      "number": 4905,
      "numberInSurah": 4,
      "juz": 27,
      "text": "عَلَّمَهُ ٱلْبَيَانَ"
    },
    {
      "number": 4906,
      "numberInSurah": 5,
      "juz": 27,
      "text": "ٱلشَّمْسُ وَٱلْقَمَرُ بِحُسْبَانٍۢ"
    },
    {
      "number": 4907,
      "numberInSurah": 6,
      "juz": 27,
      "text": "وَٱلنَّجْمُ وَٱلشَّجَرُ يَسْجُدَانِ"
    },
    {
      "number": 4908,
      "numberInSurah": 7,
      "juz": 27,
      "text": "وَٱلسَّمَآءَ رَفَعَهَا وَوَضَعَ ٱلْمِيزَانَ"
    },
    {
      "number": 4909,
      "numberInSurah": 8,
      "juz": 27,
      "text": "أَلَّا تَطْغَوْا۟ فِى ٱلْمِيزَانِ"
    },
    {
      "number": 4910,
      "numberInSurah": 9,
      "juz": 27,
      "text": "وَأَقِيمُوا�� ٱلْوَزْنَ بِٱلْقِسْطِ وَلَا تُخْسِرُوا۟ ٱلْمِيزَانَ"
    },
    {
      "number": 4911,
      "numberInSurah": 10,
      "juz": 27,
      "text": "وَٱلْأَرْضَ وَضَعَهَا لِلْأَنَامِ"
    },
    {
      "number": 4912,
      "numberInSurah": 11,
      "juz": 27,
      "text": "فِيهَا فَٰكِهَةٌۭ وَٱلنَّخْلُ ذَاتُ ٱلْأَكْمَامِ"
    },
    {
      "number": 4913,
      "numberInSurah": 12,
      "juz": 27,
      "text": "وَٱلْحَبُّ ذُو ٱلْعَصْفِ وَٱلرَّيْحَانُ"
    },
    {
      "number": 4914,
      "numberInSurah": 13,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4915,
      "numberInSurah": 14,
      "juz": 27,
      "text": "خَلَقَ ٱلْإِنسَٰنَ مِن صَلْصَٰلٍۢ كَٱلْفَخَّارِ"
    },
    {
      "number": 4916,
      "numberInSurah": 15,
      "juz": 27,
      "text": "وَخَلَقَ ٱلْجَآنَّ مِن مَّارِجٍۢ مِّن نَّارٍۢ"
    },
    {
      "number": 4917,
      "numberInSurah": 16,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4918,
      "numberInSurah": 17,
      "juz": 27,
      "text": "رَبُّ ٱلْمَشْرِقَيْنِ وَرَبُّ ٱلْمَغْرِبَيْنِ"
    },
    {
      "number": 4919,
      "numberInSurah": 18,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4920,
      "numberInSurah": 19,
      "juz": 27,
      "text": "مَرَجَ ٱلْبَحْرَيْنِ يَلْتَقِيَانِ"
    },
    {
      "number": 4921,
      "numberInSurah": 20,
      "juz": 27,
      "text": "بَيْنَهُمَا بَرْزَخٌۭ لَّا يَبْغِيَانِ"
    },
    {
      "number": 4922,
      "numberInSurah": 21,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4923,
      "numberInSurah": 22,
      "juz": 27,
      "text": "يَخْرُجُ مِنْهُمَا ٱللُّؤْلُؤُ وَٱلْمَرْجَانُ"
    },
    {
      "number": 4924,
      "numberInSurah": 23,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4925,
      "numberInSurah": 24,
      "juz": 27,
      "text": "وَلَهُ ٱلْجَوَارِ ٱلْمُنشَـَٔاتُ فِى ٱلْبَحْرِ كَٱلْأَعْلَٰمِ"
    },
    {
      "number": 4926,
      "numberInSurah": 25,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4927,
      "numberInSurah": 26,
      "juz": 27,
      "text": "كُلُّ مَنْ عَلَيْهَا فَانٍۢ"
    },
    {
      "number": 4928,
      "numberInSurah": 27,
      "juz": 27,
      "text": "وَيَبْقَىٰ وَجْهُ رَبِّكَ ذُو ٱلْجَلَٰلِ وَٱلْإِكْرَامِ"
    },
    {
      "number": 4929,
      "numberInSurah": 28,
      "juz": 27,
      "text": "فَبِأَىِّ ءَالَآءِ رَبِّكُمَا تُكَذِّبَانِ"
    },
    {
      "number": 4930,
      "numberInSurah": 29,
      "juz": 27,
      "text": "يَسْـَٔلُهُۥ مَن فِى ٱلسَّمَٰوَٰتِ وَٱلْأَرْضِ ۚ كُلَّ يَوْمٍ هُوَ فِى شَأْنٍۢ"
